rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/state/main {
      function owner() {
        return request.auth != null && request.auth.uid == uid
          && request.auth.token.email_verified == true;
      }
      function validState() {
        return request.resource.data.keys().hasAll(['schemaVersion','revision','payload','updatedAt'])
          && request.resource.data.keys().hasOnly(['schemaVersion','revision','payload','updatedAt'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.revision is int
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 800000
          && request.resource.data.updatedAt == request.time;
      }
      allow get: if owner();
      allow create: if owner() && validState() && request.resource.data.revision == 1;
      allow update: if owner() && validState()
        && request.resource.data.revision == resource.data.revision + 1;
      // No collection listing, other users' data, or direct deletion.
    }
    // The 256-bit random document ID is a revocable submission capability.
    // It is never public, included in backups, or used for account authentication.
    function verifiedOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    match /users/{uid}/integrations/appleHealth {
      allow get, delete: if verifiedOwner(uid);
      allow create, update: if verifiedOwner(uid)
        && request.resource.data.keys().hasAll(['token','lastRecordedAt','status'])
        && request.resource.data.keys().hasOnly(['token','lastRecordedAt','lastBodyFatRecordedAt','status'])
        && request.resource.data.token is string
        && request.resource.data.token.matches('^[a-f0-9]{64}$')
        && request.resource.data.lastRecordedAt is string
        && request.resource.data.lastRecordedAt.size() <= 40
        && (!request.resource.data.keys().hasAny(['lastBodyFatRecordedAt'])
          || (request.resource.data.lastBodyFatRecordedAt is string
            && request.resource.data.lastBodyFatRecordedAt.size() <= 40))
        && request.resource.data.status is string
        && request.resource.data.status.size() <= 200;
    }
    match /weightBridges/{token} {
      function validSample(s) {
        return s is map && s.keys().hasAll(['value','unit','date','recordedAt'])
          && s.keys().hasOnly(['value','unit','date','recordedAt','bodyFatPercent','bodyFatRecordedAt'])
          && s.value is number && s.value > 0 && s.value <= 1500
          && s.unit in ['lb','kg']
          && s.date is string && s.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}
      }
      allow get, delete: if verifiedOwner(resource.data.uid);
      allow create: if token.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasAll(['uid','sample'])
        && request.resource.data.keys().hasOnly(['uid','sample'])
        && verifiedOwner(request.resource.data.uid) && request.resource.data.sample == null;
      // A holder can only replace this one bounded incoming sample. No reads,
      // lists, creation, owner changes, deletion, or access to fitness logs.
      allow update: if token.matches('^[a-f0-9]{64}$')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sample'])
        && validSample(request.resource.data.sample);
    }
  }
}
)
          && s.recordedAt is string && s.recordedAt.size() >= 20 && s.recordedAt.size() <= 40
          && (!s.keys().hasAny(['bodyFatPercent','bodyFatRecordedAt'])
            || (s.keys().hasAll(['bodyFatPercent','bodyFatRecordedAt'])
              && s.bodyFatPercent is number && s.bodyFatPercent > 0 && s.bodyFatPercent <= 100
              && s.bodyFatRecordedAt is string && s.bodyFatRecordedAt.size() >= 20 && s.bodyFatRecordedAt.size() <= 40));
      }
      allow get, delete: if verifiedOwner(resource.data.uid);
      allow create: if token.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasAll(['uid','sample'])
        && request.resource.data.keys().hasOnly(['uid','sample'])
        && verifiedOwner(request.resource.data.uid) && request.resource.data.sample == null;
      // A holder can only replace this one bounded incoming sample. No reads,
      // lists, creation, owner changes, deletion, or access to fitness logs.
      allow update: if token.matches('^[a-f0-9]{64}$')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sample'])
        && validSample(request.resource.data.sample);
    }
  }
}
